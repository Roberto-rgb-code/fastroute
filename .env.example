# Copy to .env and fill in (never commit .env)

# App
NODE_ENV=development
API_PORT=3000
WEB_PORT=4200
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_EXPIRES_IN=7d

# Postgres (docker-compose)
DATABASE_URL=postgresql://fastroute:fastroute@localhost:5432/fastroute?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Mapbox (mapa + Directions — geocoding usa geopy/Nominatim gratis)
MAPBOX_ACCESS_TOKEN=
# Usa un estilo mapbox/* para tiles fiables en GL JS. Studio Standard/import puede verse gris.
MAPBOX_STYLE_URL=mapbox://styles/mapbox/streets-v12

# Geocoding gratis (geopy + Nominatim OSM). Opcional si usas el .venv local.
# GEOCODE_PYTHON=apps/api/geopy/.venv/bin/python
# GEOCODE_SCRIPT=apps/api/geopy/geocode.py

# Google Maps (fallback opcional)
GOOGLE_MAPS_API_KEY=

# Pusher (tracking en vivo)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=us2

# GCP (optional until cloud deploy)
GCP_PROJECT_ID=
GCP_REGION=us-central1

# Storage: local | gcs | minio
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# GCS_BUCKET=
# MINIO_ENDPOINT=http://localhost:9000
