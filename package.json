{
  "name": "fastroute",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:infra": "docker compose up -d postgres redis",
    "dev:up": "docker compose up -d --build",
    "dev:down": "docker compose down",
    "dev:api": "npm run start:dev -w @fastroute/api",
    "dev:web": "npm run start -w @fastroute/web",
    "dev:mobile": "npm run start -w @fastroute/mobile",
    "dev:android": "bash scripts/dev-mobile-android.sh",
    "dev:android:watchdog": "bash scripts/android-emulator.sh watchdog",
    "db:migrate": "npm run prisma:migrate -w @fastroute/api",
    "db:seed": "npm run prisma:seed -w @fastroute/api",
    "db:studio": "npm run prisma:studio -w @fastroute/api",
    "prisma:generate": "npm run prisma:generate -w @fastroute/api",
    "test": "npm run test -w @fastroute/api && npm run test -w @fastroute/web",
    "test:ci": "npm run test:ci -w @fastroute/api && npm run test:ci -w @fastroute/web",
    "typecheck:api": "npm run typecheck -w @fastroute/api",
    "typecheck:mobile": "npm --prefix apps/mobile ci && npm --prefix apps/mobile run typecheck",
    "build:api": "npm run build -w @fastroute/api",
    "build:web": "npm run build -w @fastroute/web -- --configuration production",
    "build:ci": "npm run prisma:generate && npm run build:api && npm run build:web",
    "qa": "bash scripts/qa.sh"
  },
  "engines": {
    "node": ">=20"
  }
}
